{
  "name": "sdd-frontend-min-template",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev -p 3000 apps/web",
    "build": "next build apps/web",
    "start": "next start apps/web -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:types": "openapi-typescript docs/specs/api/openapi.yaml -o apps/web/lib/types/openapi.d.ts",
    "gen:page": "ts-node --transpile-only scripts/gen-page-from-spec.ts apps/web/features/customers/spec/page.customer-list.yml",
    "test": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "next": "14.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.8.0",
    "eslint-config-next": "14.2.5",
    "js-yaml": "^4.1.0",
    "msw": "^2.4.6",
    "openapi-typescript": "^7.4.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
